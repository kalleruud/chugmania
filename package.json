{
  "name": "chugmania",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "backend/src/server.ts",
  "scripts": {
    "start": "NODE_ENV=production node dist/server/server.js",
    "dev": "tsx watch --env-file .env backend/src/server.ts",
    "check": "node scripts/check.js",
    "test": "bun test --preload ./tests/setup.ts",
    "fix": "eslint . --cache --fix && prettier -w .",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "tsup backend/src/server.ts --format esm --target node24 --external vite --out-dir dist/server --clean",
    "db:gen": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "webhook:gen": "npx --yes --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 openapi-typescript https://raw.githubusercontent.com/kalleruud/tm-webhooks-plugin/ae49b8fec14603b8287929af9f908ee350f3b30d/openapi.yaml --root-types --root-types-no-schema-prefix --output backend/src/models/webhook.generated.ts && eslint backend/src/models/webhook.generated.ts --fix && prettier --write backend/src/models/webhook.generated.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "glicko2": "^1.2.4",
    "ics": "^3.12.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.73.0",
    "luxon": "^3.7.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-router": "^8.5.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "@fontsource/titillium-web": "^5.3.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/babel__core": "^7.20.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tailwindcss-safe-area": "^1.3.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "esbuild": true,
    "better-sqlite3": false,
    "fsevents": true,
    "unrs-resolver": false
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.23.15",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
